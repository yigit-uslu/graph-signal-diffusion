# Data directories (large datasets)
# Ignore everything in data/ except raw/ subfolders
data/*
!data/*/
data/*/*
!data/*/raw/
!data/*/raw/**

# Also track cleaned SP500 data (cleaned_* subdirectories)
!data/sp500/cleaned_*/
!data/sp500/cleaned_*/raw/
!data/sp500/cleaned_*/raw/**
!data/sp500/cleaned_*/metadata.json

# But ignore processed and plots subdirectories in cleaned SP500 data
data/sp500/cleaned_*/processed*/
data/sp500/cleaned_*/plots/

# Ignore instantaneous channel files (too large for GitHub LFS >2GB limit)
**/wra_h_instantaneous.npz

# Logs
*.log
*.pot
logs/

